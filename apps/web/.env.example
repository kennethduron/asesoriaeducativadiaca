NEXT_PUBLIC_SITE_URL=
LEADS_API_URL=https://asesoriaeducativadiaca-bih6.vercel.app/api/leads

# Supabase DEVELOPMENT only. The publishable key is designed for browser use;
# RLS remains the authorization boundary. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the isolated task reminder cron; never expose these
# through NEXT_PUBLIC variables or client bundles.
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUTH_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public Firebase Web App configuration used only to register web-push clients.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
